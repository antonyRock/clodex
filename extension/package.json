{
  "name": "clodex",
  "displayName": "Clodex",
  "description": "Чаты Claude Code и Codex в одном списке: поиск по тексту, непрочитанные, фильтры.",
  "version": "0.9.6",
  "publisher": "clodex",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clodex",
          "title": "Clodex",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "clodex": [
        {
          "type": "webview",
          "id": "clodex.chats",
          "name": "Чаты"
        },
        {
          "type": "webview",
          "id": "clodex.screens",
          "name": "Скриншоты"
        }
      ]
    },
    "configuration": {
      "title": "Clodex",
      "properties": {
        "clodex.registryPath": {
          "type": "string",
          "default": "",
          "description": "Путь к реестру проектов (таблица с колонкой «Признаки») для автоматических групп. Пусто — ~/Claude_AI/03_Проекты/00_Реестр проектов.md; файла нет — автогрупп нет."
        },
        "clodex.lightTheme": {
          "type": "string",
          "default": "Light Modern",
          "description": "Светлая тема VS Code для кнопки ☀/☾ в Clodex (название как в Cmd+K Cmd+T)."
        },
        "clodex.darkTheme": {
          "type": "string",
          "default": "Dark Modern",
          "description": "Тёмная тема VS Code для кнопки ☀/☾ в Clodex (название как в Cmd+K Cmd+T)."
        },
        "clodex.screenshotsDir": {
          "type": "string",
          "default": "",
          "description": "Папка скриншотов с айфона. Пусто — ~/Claude_AI/06_Загрузки/05_Скриншоты. Команды айфона «Скрин в Clodex» и «В Clodex» сохраняют в iCloud Drive → Команды → Clodex, Clodex переносит оттуда сюда."
        }
      }
    },
    "commands": [
      {
        "command": "clodex.newChat",
        "title": "Clodex: Новый чат",
        "icon": "$(add)"
      },
      {
        "command": "clodex.newGroup",
        "title": "Clodex: Новая группа",
        "icon": "$(new-folder)"
      },
      {
        "command": "clodex.refresh",
        "title": "Clodex: Обновить список",
        "icon": "$(refresh)"
      },
      {
        "command": "clodex.markAllRead",
        "title": "Clodex: Отметить все прочитанными",
        "icon": "$(check-all)"
      },
      {
        "command": "clodex.focusSearch",
        "title": "Clodex: Поиск по чатам"
      },
      {
        "command": "clodex.expandAll",
        "title": "Clodex: Раскрыть все группы",
        "icon": "$(expand-all)"
      },
      {
        "command": "clodex.collapseAll",
        "title": "Clodex: Свернуть все группы",
        "icon": "$(collapse-all)"
      },
      {
        "command": "clodex.toggleTheme",
        "title": "Clodex: Светлая / тёмная тема VS Code",
        "icon": "$(color-mode)"
      },
      {
        "command": "clodex.screens.refresh",
        "title": "Clodex: Обновить скриншоты",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "clodex.markAllRead",
          "when": "view == clodex.chats",
          "group": "navigation@1"
        },
        {
          "command": "clodex.refresh",
          "when": "view == clodex.chats",
          "group": "navigation@2"
        }
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antonyRock/clodex"
  }
}